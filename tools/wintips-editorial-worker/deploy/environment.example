# Review the API origin before deployment. Real secrets stay outside Git.
WINTIPS_EDITORIAL_API_BASE=https://api.wintips-expert.com
WINTIPS_EDITORIAL_WORKER_TOKEN=
# Optional recovery policy is provisioned by the shared hub installer in its
# shared EnvironmentFile, after review, for both workers together:
# RDJ_PETIT_PUBLICATION_POLICY=upcoming-verified-cards-v1
# Requires the matching canonical shared hub; absent means all-cards-required-v1.
# Explicit cloud provider. Put the credential in a private EnvironmentFile.
# No account/key is created here. Never commit a real key.
WINTIPS_EDITORIAL_TRANSLATOR=gemini
WINTIPS_EDITORIAL_GEMINI_KEY=
WINTIPS_EDITORIAL_GEMINI_MODEL=gemini-3.5-flash-lite
# Shared budget across BOTH workers using the same Google project/key.
WINTIPS_EDITORIAL_GEMINI_DAILY_CHARACTERS=100000
WINTIPS_EDITORIAL_GEMINI_MONTHLY_CHARACTERS=3000000
WINTIPS_EDITORIAL_GEMINI_QUOTA_DIR=/var/lib/rdj-gemini-quota
# Install the reviewed Gemini service drop-in granting this shared path.
# Cloud mode ignores local-model settings and never falls back to them.
WINTIPS_EDITORIAL_MANAGE_MODEL=false
# Canonical Basket USA parser owned by the BigWin checkout; no copied collector.
# Optional when RDJ_HUB_CODE_ROOT already points to its sibling rdj-source-hub.
NBA_JOURNAL_CODE_ROOT=/var/www/proxidream/api-bigwin/tools/journal-parieur-worker
# The following flags belong to the API environment, NOT this worker file:
# WINTIPS_EDITORIAL_IMPORT_ENABLED=false until the publication GO
# WINTIPS_EDITORIAL_NOTIFICATIONS_ENABLED=false until the notification GO
# WINTIPS_EDITORIAL_REQUIRE_EN=true
# WINTIPS_EDITORIAL_LEGACY_BRIDGE=true during the mobile transition
