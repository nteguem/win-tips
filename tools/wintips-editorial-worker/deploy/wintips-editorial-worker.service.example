# EXAMPLE ONLY: review paths and environment before any installation.
# Remains dry-run until deployment and publication have been approved.
[Unit]
Description=WinTips RDJ editorial source check (unarmed example)
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/wintips/api/tools/wintips-editorial-worker
EnvironmentFile=/etc/wintips-editorial-worker.env
ExecStart=/usr/bin/python3 -B -m editorial_worker --dry-run --translate --output /var/lib/wintips-editorial-worker
# After GO, replace --dry-run --translate with --publish. Never enable implicitly.
StateDirectory=wintips-editorial-worker
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wintips-editorial-worker
RestrictSUIDSGID=true
MemoryMax=1G
CPUQuota=100%
TimeoutStartSec=2400
# Azure needs no local model, systemd model control or BigWin lock path.
# The state directory/credential file remain root-owned and private.
# Explicit legacy local mode needs its separately reviewed lock-path drop-in.
