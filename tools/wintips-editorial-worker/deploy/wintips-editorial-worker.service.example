# EXAMPLE ONLY: review paths and environment before any installation.
# Remains dry-run until deployment and publication have been approved.
[Unit]
Description=WinTips RDJ editorial source check (unarmed example)
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/wintips/api/tools/wintips-editorial-worker
EnvironmentFile=-/etc/wintips-editorial-worker.env
ExecStart=/usr/bin/python3 -B -m editorial_worker --dry-run --translate --output /var/lib/wintips-editorial-worker
# After GO, replace --dry-run --translate with --publish. Never enable implicitly.
StateDirectory=wintips-editorial-worker
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wintips-editorial-worker /var/lib/journal-parieur-worker/worker.lock /var/lib/journal-parieur-worker/daily-run/worker.lock
RestrictSUIDSGID=true
MemoryMax=1G
CPUQuota=100%
TimeoutStartSec=2400
# Qwen uses its existing, separately bounded 6.5GiB/2CPU service only on demand.
# root is required by the existing root-owned shared locks and systemd control;
# the worker has read-only system files and only the state/lock paths above writable.
