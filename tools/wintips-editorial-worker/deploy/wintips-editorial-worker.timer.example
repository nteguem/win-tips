# EXAMPLE ONLY: no installation or activation is performed by this package.
[Unit]
Description=WinTips RDJ check every ten minutes (unarmed example)

[Timer]
OnCalendar=*-*-* *:02/10:00 UTC
RandomizedDelaySec=30
Persistent=false
Unit=wintips-editorial-worker.service

[Install]
WantedBy=timers.target
