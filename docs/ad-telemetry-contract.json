{
  "schemaVersion": 1,
  "endpoint": "/api/ads/telemetry/batch",
  "method": "POST",
  "maxBatchSize": 20,
  "maxBodyBytes": 32768,
  "maxAgeHours": 24,
  "futureToleranceMinutes": 5,
  "retentionDays": 14,
  "rateLimitBatchesPerIpPerMinute": 30,
  "requiredEventFields": ["eventId", "attemptId", "type", "format", "placement", "occurredAt", "platform"],
  "optionalEventFields": ["appVersion", "country", "durationMs", "errorOrigin", "errorCode", "errorDomain", "adapterClassName", "reason", "connectionType", "revenueMicros", "currencyCode", "precisionType"],
  "types": ["load_attempt", "load_success", "load_failure", "load_skipped", "cache_hit", "cache_miss", "cache_expired", "show_attempt", "show_success", "show_failure", "show_skipped", "impression", "reward", "dismiss", "paid"],
  "formats": ["interstitial", "rewarded", "rewarded_interstitial", "banner", "native", "app_open"],
  "platforms": ["android", "ios", "web"],
  "errorOrigins": ["sdk", "local"],
  "reasons": ["vip", "ineligible", "unsupported", "not_ready", "already_showing", "disposed", "timeout", "request_exception", "show_exception", "ssv_setup_failed", "cancelled", "expired", "unknown"],
  "connectionTypes": ["wifi", "mobile", "ethernet", "none", "other", "unknown"],
  "precisionTypes": ["unknown", "estimated", "publisher_provided", "precise"],
  "paidOnlyFields": ["revenueMicros", "currencyCode", "precisionType"],
  "forbiddenData": ["deviceId", "userId", "token", "email", "ip", "errorMessage", "stackTrace", "ssvNonce", "adUnitId"],
  "adminSummaryEndpoint": "/api/admin/ads/telemetry/summary",
  "revenueSource": "client_reported_not_accounting",
  "audienceMetrics": "not_available_no_persistent_user_identifier"
}
